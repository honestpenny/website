---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Deadlines from "../../components/Deadlines.astro";
import GuideRow from "../../components/GuideRow.astro";
import TableWrap from "../../components/TableWrap.astro";
import Stamp from "../../components/Stamp.astro";
import { site } from "../../lib/site";
import { longDate, isoDate, PLACE_LABEL } from "../../lib/format";
import { topicLabel, readingMinutes, byChecked } from "../../lib/guides";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((g) => ({ params: { slug: g.id }, props: { g, all: guides } }));
}
const { g, all } = Astro.props;
const { Content, headings } = await render(g);
const d = g.data;
const url = `${site.url}/guides/${g.id}/`;
const minutes = readingMinutes(g);
const article = {
  "@context": "https://schema.org", "@type": "Article", "@id": `${url}#article`, headline: d.title, description: d.summary,
  inLanguage: "en-CA", mainEntityOfPage: url, datePublished: isoDate(d.published), dateModified: isoDate(d.lastChecked),
  author: { "@type": "Organization", name: d.author, "@id": `${site.url}/#org`, url: `${site.url}${site.author.url}` },
  ...(d.reviewedBy ? { reviewedBy: { "@type": "Person", name: d.reviewedBy } } : {}),
  publisher: { "@id": `${site.url}/#org` },
  image: `${site.url}/og/${g.id}.png`,
  articleSection: topicLabel(d.topic), timeRequired: `PT${minutes}M`, isAccessibleForFree: true,
  spatialCoverage: d.applies.map((a) => ({ "@type": "Place", name: PLACE_LABEL[a] })),
  citation: d.sources.map((s) => s.url),
};
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
  { "@type": "ListItem", position: 2, name: "Guides", item: `${site.url}/guides/` },
  { "@type": "ListItem", position: 3, name: d.title, item: url } ] };
const toc = [...headings.filter((h) => h.depth === 2), { depth: 2, slug: "sources-h", text: "Where these facts come from" }];
const related = all.filter((o) => o.id !== g.id).sort((a, b) => Number(b.data.topic === d.topic) - Number(a.data.topic === d.topic) || byChecked(a, b)).slice(0, 3);
const places = d.applies.map((a) => PLACE_LABEL[a]);
const host = (u: string) => new URL(u).hostname.replace(/^www\./, "");
---
<Base title={d.title} description={d.summary} jsonLd={[article, crumbs]} ogImage={`/og/${g.id}.png`} ogType="article">
  <header class="g-head">
    <nav aria-label="Breadcrumb" class="crumb"><ol><li><a href="/">Home</a></li><li><a href="/guides/">Guides</a></li><li><a href={`/guides/#${d.topic}`}>{topicLabel(d.topic)}</a></li></ol></nav>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <div class="meta">
      <Stamp checked={d.lastChecked} next={d.nextReview} by={d.reviewedBy ? `${d.author}, reviewed by ${d.reviewedBy}` : d.author} byHref={site.author.url} />
      <p class="facts"><span data-testid="applies-to"><span class="lbl">Applies to</span> {places.map((p) => <span class="tag">{p}</span>)}</span>
        <span><span class="lbl">Reading time</span> {minutes} minutes</span></p>
    </div>
  </header>

  <div class="g-grid">
    <article class="prose g-body">
      <Deadlines items={d.deadlines} />
      {toc.length > 3 && (
        <details class="toc-inline">
          <summary>On this page <span class="muted">({toc.length} sections)</span></summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <Content components={{ table: TableWrap }} />
      <section aria-labelledby="sources-h" class="sources">
        <h2 id="sources-h">Where these facts come from</h2>
        <p class="muted">Official sources first. Each was checked on the date shown.</p>
        <ol>
          {d.sources.map((s) => (
            <li data-testid="source"><a href={s.url} rel="noopener">{s.title}</a><br /><span class="muted small">{s.publisher} · {host(s.url)} · checked {longDate(s.checked)}</span></li>
          ))}
        </ol>
        <p class="box"><span class="box-label">Spotted a mistake?</span>If something is wrong or out of date, <a href="/corrections/">tell us</a>. We fix errors and note the change.</p>
        <p class="muted small">General information for people in {places.join(", ")}, not personal financial, tax or legal advice. Rules change; check the official source before you act. <a href="/terms/">Terms and disclaimer</a>.</p>
        <p class="no-print"><a href="#main">Back to top</a></p>
      </section>
    </article>

    {toc.length > 3 && (
      <aside class="toc-side" aria-labelledby="toc-h">
        <nav aria-labelledby="toc-h">
          <h2 id="toc-h" class="toc-h">On this page</h2>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      </aside>
    )}
  </div>

  <section class="related no-print" aria-labelledby="rel-h">
    <h2 id="rel-h">Read next</h2>
    <ul class="grid">{related.map((r) => <GuideRow g={r} />)}</ul>
  </section>
</Base>
<script is:inline>
  // Highlight the section you're reading in the sidebar (aria-current). No motion; works without it.
  (() => {
    const links = [...document.querySelectorAll(".toc-side a")];
    if (!links.length || !("IntersectionObserver" in window)) return;
    const byId = new Map(links.map((a) => [a.getAttribute("href").slice(1), a]));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        links.forEach((a) => a.removeAttribute("aria-current"));
        byId.get(e.target.id)?.setAttribute("aria-current", "true");
      }
    }, { rootMargin: "0px 0px -70% 0px" });
    byId.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
  })();
</script>
<style>
  .g-head { position: relative; isolation: isolate; padding: clamp(1.75rem, 5vw, 3.5rem) 0 2.25rem; margin-bottom: 2.5rem; }
  .g-head::before { content: ""; position: absolute; inset: 0 calc(50% - 50vw); z-index: -1; background: var(--soft); }
  .g-head h1 { max-width: 18ch; font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4.2rem); }
  .g-head .lede { max-width: var(--measure); }
  .crumb ol { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; font-size: 0.95rem; }
  .crumb li { margin: 0; display: flex; align-items: center; }
  .crumb li + li::before { content: "/"; color: var(--muted); padding: 0 0.5rem; }
  .crumb a { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; min-width: 24px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin: 1.75rem 0 0; }
  .facts { margin: 0; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.95rem; }
  .facts > span { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; }
  .lbl { font-weight: 700; margin-right: 0.25rem; }

  .g-grid { display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .g-grid { grid-template-columns: minmax(0, var(--measure)) minmax(14rem, 18rem); justify-content: space-between; } .toc-inline { display: none; } }
  @media (max-width: 63.99rem) { .toc-side { display: none; } }
  .toc-side nav { position: sticky; top: 1.5rem; background: var(--soft); border-radius: var(--r); padding: 1.25rem 1.25rem 1.25rem 1rem; max-height: calc(100vh - 3rem); overflow: auto; }
  .toc-h { font: 650 1.1rem/1.3 var(--display); margin: 0 0 0.5rem; }
  .toc-side ol { list-style: none; padding: 0; margin: 0; font-size: 0.95rem; }
  .toc-side li { margin: 0; }
  .toc-side a { display: block; padding: 0.4rem 0.6rem; border-left: 3px solid transparent; border-radius: 0 8px 8px 0; color: var(--muted); text-decoration: none; line-height: 1.35; }
  .toc-side a:hover { color: var(--ink); text-decoration: underline; }
  .toc-side a[aria-current] { color: var(--ink); font-weight: 700; border-left-color: var(--penny); background: var(--card); }
  .toc-inline { border: 0; border-radius: var(--r); background: var(--soft); padding: 0.25rem 1.1rem; margin: 1.5rem 0; }
  .toc-inline ol { margin: 0.25rem 0 0.9rem; padding-left: 1.3rem; }
  .toc-inline a { display: inline-block; padding: 0.15rem 0; }

  .g-body :global(h2) { padding-top: 0.5rem; }
  .sources { margin-top: 3.5rem; padding: 0.5rem 1.5rem 1rem; background: var(--soft); border-radius: var(--r); }
  .sources ol li::marker { color: var(--penny-text); font-weight: 700; }
  .sources ol { padding-left: 1.3rem; }
  .sources li { margin-bottom: 0.8rem; }
  .related { margin-top: 4rem; }
  .entries { padding: 0; margin: 0; }
</style>
