---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Deadlines from "../../components/Deadlines.astro";
import { site } from "../../lib/site";
import { longDate, isoDate, PLACE_LABEL } from "../../lib/format";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content, headings } = await render(g);
const d = g.data;
const url = `${site.url}/guides/${g.id}/`;
const article = {
  "@context": "https://schema.org", "@type": "Article", headline: d.title, description: d.summary,
  inLanguage: "en-CA", mainEntityOfPage: url, datePublished: isoDate(d.published), dateModified: isoDate(d.lastChecked),
  author: { "@type": "Organization", name: d.author, url: `${site.url}${site.author.url}` },
  ...(d.reviewedBy ? { reviewedBy: { "@type": "Person", name: d.reviewedBy } } : {}),
  publisher: { "@id": `${site.url}/#org` },
  spatialCoverage: d.applies.map((a) => ({ "@type": "Place", name: PLACE_LABEL[a] })),
  citation: d.sources.map((s) => s.url),
};
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Guides", item: `${site.url}/guides/` },
  { "@type": "ListItem", position: 2, name: d.title, item: url } ] };
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={d.title} description={d.summary} jsonLd={[article, crumbs]}>
  <article class="prose">
    <p class="crumb"><a href="/guides/">Guides</a></p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <p class="meta">
      <span data-testid="applies-to"><strong>Applies to:</strong> {d.applies.map((a) => PLACE_LABEL[a]).join(", ")}</span><br />
      By <a href={site.author.url}>{d.author}</a>{d.reviewedBy && <> · Reviewed by {d.reviewedBy}</>} ·
      Facts last checked <time data-testid="last-checked" datetime={isoDate(d.lastChecked)}>{longDate(d.lastChecked)}</time> ·
      Next check due {longDate(d.nextReview)}
    </p>
    <Deadlines items={d.deadlines} />
    {toc.length > 2 && (
      <nav aria-label="In this guide" class="toc"><p class="box-label">In this guide</p><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
    )}
    <Content />
    <section aria-labelledby="sources-h" class="sources">
      <h2 id="sources-h">Where these facts come from</h2>
      <p class="muted">We use official sources first. Each was checked on the date shown.</p>
      <ol>
        {d.sources.map((s) => (
          <li data-testid="source"><a href={s.url} rel="noopener">{s.title}</a>, {s.publisher} <span class="muted">(checked {longDate(s.checked)})</span></li>
        ))}
      </ol>
      <p>Spotted something wrong or out of date? <a href="/corrections/">Tell us</a>. We fix errors and note the change.</p>
      <p class="muted small">General information for people in {d.applies.map((a) => PLACE_LABEL[a]).join(", ")}, not personal financial or legal advice. Rules change; check the official source before you act.</p>
    </section>
  </article>
</Base>
<style>
  .crumb { margin: 1.5rem 0 0; font-size: 1rem; }
  .lede { font-size: 1.25rem; }
  .meta { color: var(--muted); font-size: 1rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 0.6rem 0; }
  .meta a { color: var(--link); }
  .toc ol { margin-bottom: 0; } .toc { margin: 1.5rem 0; }
  .sources { margin-top: 3rem; border-top: 3px solid var(--copper); }
  .small { font-size: 0.95rem; }
</style>
