---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Signup from "../components/Signup.astro";
import GuideRow from "../components/GuideRow.astro";
import { site } from "../lib/site";
import { isoDate } from "../lib/format";
import { TOPICS, byChecked } from "../lib/guides";

const guides = (await getCollection("guides", ({ data }) => !data.draft)).sort(byChecked);
const today = new Date();
const upcoming = guides
  .flatMap((g) => g.data.deadlines.map((d) => ({ ...d, guide: g })))
  .filter((d) => d.date >= today)
  .sort((a, b) => +a.date - +b.date)
  .slice(0, 4);
const mon = (d: Date) => d.toLocaleDateString("en-CA", { month: "short", timeZone: "UTC" }).replace(".", "");
const day = (d: Date) => d.toLocaleDateString("en-CA", { day: "numeric", timeZone: "UTC" });
const yr = (d: Date) => d.getUTCFullYear();
const topics = TOPICS.map((t) => ({ ...t, items: guides.filter((g) => g.data.topic === t.id) })).filter((t) => t.items.length);
const tools = [
  { href: "/guides/alberta-income-tax-brackets-2026/#tx-h", title: "Alberta tax calculator", text: "Your 2026 tax, and what a raise or RRSP contribution really changes." },
  { href: "/guides/challenge-property-assessment-alberta/#ptc-h", title: "Property tax saving", text: "What a lower assessment would knock off your tax bill." },
  { href: "/guides/alberta-electricity-rate-2027/#ec-h", title: "Power rate comparison", text: "Is a retailer's offer really cheaper than the default rate?" },
];
---
<Base title="Home" description={site.description}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Alberta first · Canada-wide · Free</p>
      <h1>Money help for Albertans that isn't selling you anything</h1>
      <p class="lede">Plain guides to cutting bills, claiming what you're owed and saving more. Every number links to the official source, with the date we checked it.</p>
      <div class="cta">
        <a class="button" href="/guides/honest-penny-steps/">Start with the 8 Steps <span aria-hidden="true">→</span></a>
        <a class="button secondary" href="/guides/">Browse all guides</a>
      </div>
      <ul class="proof" aria-label="Why you can trust these guides">
        <li><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" /></svg>Facts linked to canada.ca, alberta.ca and other official sources</li>
        <li><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" /></svg>No company can pay to be listed or ranked</li>
        <li><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" /></svg>Each guide shows when it was last checked</li>
      </ul>
    </div>

    <aside class="soon" aria-labelledby="soon-h">
      <h2 id="soon-h" class="soon-h">Dates coming up</h2>
      {upcoming.length ? (
        <ol class="dates">
          {upcoming.map((d) => (
            <li>
              <time class="tile" datetime={isoDate(d.date)}>
                <span class="m">{mon(d.date)}</span><span class="d">{day(d.date)}</span><span class="sr-only"> {yr(d.date)}</span>
              </time>
              <div>
                <p class="when muted small">{d.approximate ? "About this date, " : ""}{yr(d.date)}</p>
                <p class="what">{d.label}</p>
                <a href={`/guides/${d.guide.id}/`}>{d.guide.data.title}</a>
              </div>
            </li>
          ))}
        </ol>
      ) : <p>No deadlines in the next few weeks.</p>}
    </aside>
  </section>

  <section class="section" aria-labelledby="topics-h">
    <h2 id="topics-h" class="section-h">What do you want to sort out?</h2>
    <div class="topics">
      {topics.map((t) => (
        <section class="topic" aria-labelledby={`t-${t.id}`}>
          <h3 id={`t-${t.id}`}><a href={`/guides/#${t.id}`}>{t.label}</a></h3>
          <p class="muted small">{t.blurb}</p>
          <ul>{t.items.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}</ul>
        </section>
      ))}
    </div>
  </section>

  <section class="section band-full" aria-labelledby="latest-h">
    <h2 id="latest-h" class="section-h">Recently checked guides</h2>
    <ul class="cards">{guides.slice(0, 6).map((g) => <GuideRow g={g} />)}</ul>
    <p><a href="/guides/">See all {guides.length} guides</a></p>
  </section>

  <section class="section" aria-labelledby="tools-h">
    <h2 id="tools-h" class="section-h">Quick calculators</h2>
    <p class="muted">They run in your browser. Nothing you type is sent anywhere.</p>
    <ul class="tools">
      {tools.map((t) => (
        <li><a href={t.href}><span class="tool-t">{t.title}</span><span class="tool-x">{t.text}</span></a></li>
      ))}
    </ul>
  </section>

  <Signup />

  <section class="section" aria-labelledby="why-h">
    <h2 id="why-h" class="section-h">Why trust us</h2>
    <div class="why">
      <div><h3>No paid placements</h3><p>No company can pay to be listed, ranked or reviewed. <a href="/editorial-code/">Our editorial code</a></p></div>
      <div><h3>Open about money</h3><p>We tell you exactly how we make money. Right now: <a href="/how-we-make-money/">we don't</a>.</p></div>
      <div><h3>Sourced and dated</h3><p>Every fact has an official source and the date we checked it. <a href="/how-we-check-facts/">How we check</a></p></div>
    </div>
  </section>
</Base>
<style>
  .hero { display: grid; gap: 2.5rem; padding: clamp(2rem, 5vw, 4rem) 0 clamp(2rem, 4vw, 3rem); align-items: start; }
  @media (min-width: 60rem) { .hero { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 4rem; } }
  .hero h1 { max-width: 20ch; }
  .lede { max-width: 36rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.75rem 0; }
  .proof { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; font-size: 1rem; }
  .proof li { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0; }
  .proof svg { width: 1.25rem; height: 1.25rem; flex: none; margin-top: 0.2rem; fill: none; stroke: var(--spruce); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .soon { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
  .soon-h { font-size: 1.3rem; margin: 0 0 1rem; }
  .dates { list-style: none; padding: 0; margin: 0; }
  .dates li { display: grid; grid-template-columns: 3.6rem 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); margin: 0; }
  .dates li:first-child { border-top: 0; padding-top: 0.25rem; }
  .tile { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2px solid var(--deadline-edge); border-radius: var(--radius-sm); background: var(--tint-deadline); height: 3.6rem; line-height: 1; }
  .tile .m { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .tile .d { font: 700 1.5rem/1.05 var(--serif); }
  .when { margin: 0; }
  .what { margin: 0.1rem 0 0.35rem; font-size: 1rem; }
  .dates a { font-size: 0.95rem; }

  .topics { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .topic { border-top: 3px solid var(--copper); padding-top: 0.9rem; }
  .topic h3 { margin: 0 0 0.2rem; font-size: 1.35rem; }
  .topic h3 a { color: var(--ink); text-decoration: none; }
  .topic h3 a:hover { text-decoration: underline; }
  .topic ul { padding-left: 1.1rem; margin-bottom: 0.5rem; }
  .topic li { font-size: 1rem; }

  .band-full { position: relative; isolation: isolate; }
  .band-full::before { content: ""; position: absolute; inset: 0 calc(50% - 50vw); background: var(--sunk); border-block: 1px solid var(--line); z-index: -1; }
  .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); padding: 0; margin: 0 0 1.25rem; }

  .tools { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .tools li { margin: 0; }
  .tools a { display: flex; flex-direction: column; gap: 0.3rem; height: 100%; padding: 1.1rem 1.25rem; border: 2px solid var(--border); border-radius: var(--radius); text-decoration: none; color: var(--ink); background: var(--surface); }
  .tools a:visited { color: var(--ink); }
  .tools a:hover { border-color: var(--spruce); }
  .tool-t { font: 700 1.15rem/1.3 var(--serif); color: var(--link); text-decoration: underline; text-underline-offset: 0.2em; }
  .tool-x { font-size: 1rem; color: var(--muted); }

  .why { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .why h3 { margin-top: 0; }
  .why p { margin: 0; }
</style>
