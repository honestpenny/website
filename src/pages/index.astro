---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Signup from "../components/Signup.astro";
import GuideRow from "../components/GuideRow.astro";
import Stamp from "../components/Stamp.astro";
import Fact from "../components/Fact.astro";
import { site } from "../lib/site";
import { isoDate } from "../lib/format";
import { TOPICS, byChecked } from "../lib/guides";
import { allDeadlines, isPast, calTitle } from "../lib/deadlines";
import { STEPS } from "../lib/steps";

const guides = (await getCollection("guides", ({ data }) => !data.draft)).sort(byChecked);
const upcoming = (await allDeadlines()).filter((d) => !isPast(d.date));
const tally = upcoming.slice(0, 3);
const mon = (d: Date) => d.toLocaleDateString("en-CA", { month: "short", day: "numeric", timeZone: "UTC" }).replace(".", "");
const topics = TOPICS.map((t) => ({ ...t, items: guides.filter((g) => g.data.topic === t.id) })).filter((t) => t.items.length);
const newest = guides[0].data.lastChecked;
const tools = [
  { href: "/check/", title: "Check what you're owed", text: "Seven questions. A checklist of benefits and credits you might be missing, with the official link for each." },
  { href: "/guides/alberta-income-tax-brackets-2026/#tx-h", title: "Alberta tax calculator", text: "Your 2026 tax, and what a raise or RRSP contribution really changes." },
  { href: "/guides/challenge-property-assessment-alberta/#ptc-h", title: "Property tax saving", text: "What a lower assessment would knock off your tax bill." },
  { href: "/guides/alberta-electricity-rate-2027/#ec-h", title: "Power rate comparison", text: "Is a retailer's offer really cheaper than the default rate?" },
];
---
<Base title="Home" description={site.description}>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Free, independent money help for Alberta and Canada</p>
      <h1>Money help for Albertans that isn't selling you anything</h1>
      <p class="lede">Plain guides to cutting bills, claiming what you're owed and saving more. Every number links to the official source, with the date we checked it.</p>
      <div class="cta">
        <a class="button" href="/check/">Check what you're owed <span aria-hidden="true">→</span></a>
        <a class="text-cta" href="/guides/honest-penny-steps/">Or start the 8 Steps</a>
      </div>
      <p class="penny">The penny left our pockets on <Fact id="penny-distribution-ended" />. <strong>Every cent still counts.</strong></p>
    </div>

    <aside class="tally-wrap" aria-labelledby="tally-h">
      <div class="tally">
        <h2 id="tally-h" class="tally-h">Coming up</h2>
        <p class="tally-sub num">As of {new Date().toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric", timeZone: "America/Edmonton" })}</p>
        <ol class="tally-rows">
          {tally.map((d) => (
            <li><time class="num" datetime={isoDate(d.date)}>{d.approximate ? "~" : ""}{mon(d.date)}</time><a href={`/dates/#${d.id}`}>{calTitle(d)}</a></li>
          ))}
        </ol>
        <p class="tally-total"><span>Dates to know</span><span class="num">{upcoming.length}</span></p>
        <p class="tally-foot"><a href="/dates/">See every date and add them to your calendar</a></p>
      </div>
      <Signup compact />
    </aside>
  </section>

  <section class="field-band copper owed section" aria-labelledby="owed-h">
    <div class="owed-grid">
      <h2 id="owed-h">Many benefits only reach you if you file a tax return.</h2>
      <div>
        <p class="big">Answer seven quick questions and get a checklist of the federal and Alberta benefits and credits you might be able to claim, each with its official link.</p>
        <p>About 3 minutes. You don't need any bills in front of you. Nothing you answer leaves your device.</p>
        <a class="button on-field" href="/check/">Start the check <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section steps" aria-labelledby="steps-h">
    <div class="steps-intro">
      <h2 id="steps-h">The 8 Steps</h2>
      <p>A money plan built for Canada, in order. Do one step at a time; each makes the next easier. Tick them off as you go: your ticks stay on this device.</p>
      <a class="button secondary" href="/guides/honest-penny-steps/">Read the 8 Steps</a>
    </div>
    <ol class="ledger">
      {STEPS.map((s) => (
        <li><span class="n num">{String(s.n).padStart(2, "0")}</span><span class="t"><a href={`/guides/honest-penny-steps/#${s.slug}`}>{s.title}</a><span class="muted">{s.short}</span></span></li>
      ))}
    </ol>
  </section>

  <section class="section topics" aria-labelledby="topics-h">
    <h2 id="topics-h" class="section-h">What do you want to sort out?</h2>
    {topics.map((t) => (
      <div class="topic">
        <div class="topic-h"><h3 id={`t-${t.id}`}>{t.label}</h3><p class="muted">{t.blurb}</p></div>
        <ul class="entries" aria-labelledby={`t-${t.id}`}>{t.items.map((g) => <GuideRow g={g} showTopic={false} headingLevel={4} />)}</ul>
      </div>
    ))}
    <p><a href="/guides/">All {guides.length} guides</a></p>
  </section>

  <section class="field-band spruce section" aria-labelledby="tools-h">
    <h2 id="tools-h" class="section-h">Tools that do the sums</h2>
    <p class="tools-sub">They run in your browser. Nothing you type is sent anywhere.</p>
    <ul class="tools">
      {tools.map((t) => <li><a href={t.href}><span class="tool-t">{t.title} <span aria-hidden="true">→</span></span><span class="tool-x">{t.text}</span></a></li>)}
    </ul>
  </section>

  <section class="section trust" aria-labelledby="why-h">
    <div><Stamp checked={newest} by={site.author.name} /></div>
    <div>
      <h2 id="why-h" class="section-h">Why you can trust a page here</h2>
      <p class="lede">Every guide carries a stamp like this one: who checked it, when, and when we check it next. Every official number has a small source mark next to it, like <span class="num">CRA</span> or <span class="num">Alberta</span>, that takes you to the government page.</p>
      <p>No company can pay to be listed, ranked or reviewed (<a href="/editorial-code/">our editorial code</a>). We tell you exactly how we make money; right now, <a href="/how-we-make-money/">we don't</a>. When we get something wrong, we fix it and <a href="/corrections/">log the change</a>.</p>
    </div>
  </section>
</Base>
<style>
  .hero { display: grid; gap: 2.5rem; padding: clamp(2rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 64rem) { .hero { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 4.5rem; } }
  .hero h1 { max-width: 15ch; }
  .lede { max-width: 38rem; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin: 2rem 0 1.75rem; }
  .text-cta { font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; }
  .penny { font-size: 1.05rem; border-top: 1px solid var(--rule); padding-top: 1rem; max-width: 38rem; }

  .tally-wrap { display: grid; gap: 1.25rem; }
  .tally { --edge: 9px; background: var(--receipt); padding: calc(var(--edge) + 1.1rem) 1.4rem calc(var(--edge) + 1rem); border-inline: 1px solid var(--rule);
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 90deg, #0000 91deg) bottom / calc(2 * var(--edge)) 51% repeat-x, conic-gradient(from 135deg at top, #0000, #000 1deg 90deg, #0000 91deg) top / calc(2 * var(--edge)) 51% repeat-x;
            mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 90deg, #0000 91deg) bottom / calc(2 * var(--edge)) 51% repeat-x, conic-gradient(from 135deg at top, #0000, #000 1deg 90deg, #0000 91deg) top / calc(2 * var(--edge)) 51% repeat-x; }
  .tally-h { font-size: 1.5rem; margin: 0; }
  .tally-sub { margin: 0.2rem 0 0.75rem; font-size: 0.85rem; color: var(--muted); padding-bottom: 0.6rem; border-bottom: 2px dashed var(--border); }
  .tally-rows { list-style: none; padding: 0; margin: 0; }
  .tally-rows li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.75rem; padding: 0.55rem 0; border-bottom: 1px dotted var(--border); margin: 0; font-size: 1rem; }
  .tally-rows time { font-weight: 700; }
  .tally-total { display: flex; justify-content: space-between; font-weight: 700; font-size: 1.1rem; border-top: 2px solid var(--ink); margin: 0.6rem 0 0.75rem; padding-top: 0.5rem; }
  .tally-foot { margin: 0; font-size: 0.95rem; }

  .owed-grid { display: grid; gap: 1.5rem 4rem; }
  @media (min-width: 56rem) { .owed-grid { grid-template-columns: 1.1fr 1fr; align-items: end; } }
  .owed h2 { font-size: clamp(2rem, 1.5rem + 2.2vw, 3.4rem); margin: 0; max-width: 16ch; }
  .owed .big { font-size: 1.25rem; }

  .steps { display: grid; gap: 2rem 4rem; }
  @media (min-width: 60rem) { .steps { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); } }
  .steps-intro h2 { margin-top: 0; font-size: clamp(2rem, 1.5rem + 2.2vw, 3.4rem); }
  .ledger { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
    background: var(--receipt); }
  .ledger li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.75rem; align-items: baseline; padding: 0.8rem 0.75rem; border-bottom: 1px solid var(--rule); margin: 0; }
  .ledger li:last-child { border-bottom: 0; }
  .ledger .n { font-size: 1.4rem; font-weight: 700; color: var(--copper-text); }
  .ledger .t { display: flex; flex-direction: column; gap: 0.1rem; }
  .ledger a { font: 650 1.2rem/1.25 var(--serif); color: var(--ink); }
  .ledger a:visited { color: var(--ink); }
  .ledger .muted { font-size: 0.95rem; }

  .topic { display: grid; gap: 0.5rem 3rem; padding: 1.5rem 0; }
  @media (min-width: 56rem) { .topic { grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr); } }
  .topic-h h3 { font-size: 1.75rem; margin: 1rem 0 0.25rem; }
  .entries { padding: 0; margin: 0; }

  .tools-sub { margin-bottom: 1.5rem; }
  .tools { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--on-field); }
  .tools li { margin: 0; border-bottom: 1px solid var(--on-field); }
  .tools a { display: grid; gap: 0.2rem 3rem; padding: 1.1rem 0; text-decoration: none; }
  @media (min-width: 56rem) { .tools a { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: baseline; } }
  .tool-t { font: 650 1.4rem/1.25 var(--serif); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .tools a:hover .tool-t { text-decoration-thickness: 3px; }
  .tool-x { font-size: 1.05rem; }

  .trust { display: grid; gap: 2rem 4rem; align-items: start; }
  @media (min-width: 56rem) { .trust { grid-template-columns: auto minmax(0, 1fr); } }
</style>
