---
// Kit form id comes from env at build time (PUBLIC_KIT_FORM_ID). The form only renders when BOTH the Kit
// form and a real mailing address exist: CASL requires sender name + mailing address in the consent request
// (SOR/2012-36 s.4) and in every email. Until then we say so plainly instead of showing a form that goes nowhere.
import { site } from "../lib/site";
const formId = import.meta.env.PUBLIC_KIT_FORM_ID;
const ready = Boolean(formId && site.mailingAddress);
---
<section class="signup" aria-labelledby="su-h">
  <div class="su-copy">
  <p class="eyebrow">Free weekly email</p>
  <h2 id="su-h">The weekly Honest Penny email</h2>
  <p>One short email a week: deadlines coming up, one thing worth doing, and what changed. Free. Unsubscribe in one click.</p>
  </div>
  <div class="su-act">
  {ready ? (
    <form action={`https://app.kit.com/forms/${formId}/subscriptions`} method="post">
      <div class="field"><label for="su-email">Your email</label><input id="su-email" name="email_address" type="email" autocomplete="email" required /></div>
      <div class="field consent"><input id="su-consent" name="fields[casl_consent]" type="checkbox" value="yes" required />
        <label for="su-consent">Yes, send me the weekly Honest Penny email. I can unsubscribe at any time.</label></div>
      <p class="muted small">Sent by {site.name}, {site.mailingAddress}, {site.contactEmail}. We use Kit (a US company) to send our email; see <a href="/privacy/">privacy</a>.</p>
      <button type="submit">Sign up</button>
    </form>
  ) : (
    <p class="box soon-box"><span class="box-label">Starting soon</span>The first email goes out before Alberta's January deadlines. Sign-up opens here shortly.</p>
  )}
  </div>
</section>
<style>
  .signup { display: grid; gap: 1.5rem 3rem; align-items: center; margin: 2rem 0; padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--copper); border-radius: var(--radius); }
  @media (min-width: 52rem) { .signup { grid-template-columns: 1.1fr 1fr; } }
  .signup h2 { margin: 0 0 0.6rem; }
  .su-copy > :last-child, .su-act > :last-child { margin-bottom: 0; }
  .soon-box { margin: 0; }
  .consent { display: flex; gap: 0.6rem; align-items: flex-start; }
  .consent input { width: 24px; height: 24px; margin-top: 0.2rem; flex: none; }
  .consent label { font-weight: 400; }
</style>
