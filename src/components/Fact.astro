---
// One registry value + a visible link to the official page it comes from (trust you can click).
// Unknown ids fail the build, so a typo can't ship a blank.
import { getEntry } from "astro:content";
import { longDate } from "../lib/format";
interface Props { id: string; nosource?: boolean }
const { id, nosource = false } = Astro.props;
const fact = await getEntry("facts", id);
if (!fact) throw new Error(`<Fact id="${id}"> not found in src/data/facts.yaml`);
const { value, source, checked } = fact.data;
---
<span class="fact" data-fact={id}>{value}{!nosource && <>{"\u00a0"}<a class="src" href={source.url} rel="noopener" aria-label={`Source: ${source.publisher}, checked ${longDate(checked)}`} title={`${source.title}, ${source.publisher}. Checked ${longDate(checked)}.`}>{source.short}</a></>}</span>
<style>
  /* Long values may wrap (reflow at 320px); the source chip stays glued to the value by a no-break space. */
  .src { white-space: nowrap; font-size: 0.7em; font-weight: 700; vertical-align: 0.3em; padding: 0.1em 0.45em; border-radius: 999px;
    background: var(--chip); color: var(--chip-ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .src:visited { color: var(--chip-ink); }
  .src:hover { text-decoration-thickness: 2px; }
</style>
