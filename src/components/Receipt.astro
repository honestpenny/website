---
// A worked example printed as a receipt. Underneath it's a real <table> (the look never replaces the
// semantics). Every receipt says how it was worked out and, when a figure is rounded, says so.
interface Row { label: string; amount: string; note?: string }
interface Props { title: string; rows: Row[]; total: { label: string; amount: string }; plain?: string; method?: string }
const { title, rows, total, plain, method } = Astro.props;
---
<figure class="receipt">
  <table>
    <caption>{title}</caption>
    <tbody>
      {rows.map((r) => <tr><th scope="row">{r.label}{r.note && <span class="note">{r.note}</span>}</th><td class="num">{r.amount}</td></tr>)}
    </tbody>
    <tfoot><tr><th scope="row">{total.label}</th><td class="num">{total.amount}</td></tr></tfoot>
  </table>
  {plain && <p class="plain">{plain}</p>}
  {method && <details><summary>How we worked this out</summary><p>{method}</p></details>}
</figure>
<style>
  .receipt { --edge: 10px; margin: 2rem 0; max-width: 32rem; background: var(--receipt); color: var(--ink); padding: calc(var(--edge) + 1rem) 1.35rem calc(var(--edge) + 0.9rem);
    border-inline: 1px solid var(--rule);
    /* Torn zig-zag top and bottom edge, cut with a mask so the paper itself is the shape. */
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 90deg, #0000 91deg) bottom / calc(2 * var(--edge)) 51% repeat-x,
                  conic-gradient(from 135deg at top, #0000, #000 1deg 90deg, #0000 91deg) top / calc(2 * var(--edge)) 51% repeat-x;
            mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 90deg, #0000 91deg) bottom / calc(2 * var(--edge)) 51% repeat-x,
                  conic-gradient(from 135deg at top, #0000, #000 1deg 90deg, #0000 91deg) top / calc(2 * var(--edge)) 51% repeat-x; }
  :global(.field-band) .receipt, .receipt :is(th, td, caption, p, summary) { color: var(--ink); }
  caption { text-align: left; font: 650 1.15rem/1.3 var(--serif); padding-bottom: 0.6rem; border-bottom: 2px dashed var(--border); margin-bottom: 0.3rem; }
  table { font-size: 1rem; margin: 0; }
  th, td { padding: 0.45rem 0; border-bottom: 1px dotted var(--border); font-weight: 400; }
  td { text-align: right; white-space: nowrap; padding-left: 1rem; }
  .note { display: block; font-size: 0.85rem; color: var(--muted); }
  tfoot th, tfoot td { font-weight: 700; border-bottom: 0; border-top: 2px solid var(--ink); padding-top: 0.6rem; font-size: 1.1rem; }
  .plain { margin: 0.75rem 0 0; font-size: 1rem; }
  details { margin-top: 0.5rem; font-size: 0.95rem; }
  details p { margin: 0 0 0.5rem; }
  @media print { .receipt { -webkit-mask: none; mask: none; border: 1px solid #000; } }
</style>
