---
// A worked example card. Underneath it's a real <table> (the look never replaces the
// semantics). Every receipt says how it was worked out and, when a figure is rounded, says so.
interface Row { label: string; amount: string; note?: string }
interface Props { title: string; rows: Row[]; total: { label: string; amount: string }; plain?: string; method?: string }
const { title, rows, total, plain, method } = Astro.props;
---
<figure class="receipt">
  <table>
    <caption>{title}</caption>
    <tbody>
      {rows.map((r) => <tr><th scope="row">{r.label}{r.note && <span class="note">{r.note}</span>}</th><td class="num">{r.amount}</td></tr>)}
    </tbody>
    <tfoot><tr><th scope="row">{total.label}</th><td class="num">{total.amount}</td></tr></tfoot>
  </table>
  {plain && <p class="plain">{plain}</p>}
  {method && <details><summary>How we worked this out</summary><p>{method}</p></details>}
</figure>
<style>
  .receipt { margin: 2rem 0; max-width: 34rem; background: var(--card); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); padding: 1.35rem 1.5rem 1.1rem; }
  caption { text-align: left; font: 700 1.2rem/1.3 var(--display); padding-bottom: 0.75rem; }
  caption::before { content: "Worked example"; display: block; font: 700 0.85rem/1 var(--sans); color: var(--penny-text); margin-bottom: 0.4rem; }
  table { font-size: 1rem; margin: 0; }
  th, td { padding: 0.55rem 0; border-bottom: 1px solid var(--line); font-weight: 400; background: none; }
  td { text-align: right; white-space: nowrap; padding-left: 1rem; font-variant-numeric: tabular-nums; }
  .note { display: block; font-size: 0.85rem; color: var(--muted); }
  tfoot th, tfoot td { font-weight: 700; border-bottom: 0; padding-top: 0.8rem; font-size: 1.15rem; }
  tfoot td { color: var(--green); font-size: 1.5rem; font-family: var(--display); font-weight: 800; }
  .plain { margin: 0.5rem 0 0; font-size: 1rem; background: var(--mint); border-radius: var(--r-sm); padding: 0.6rem 0.85rem; }
  details { margin-top: 0.5rem; font-size: 0.95rem; }
  details p { margin: 0 0 0.5rem; }
</style>
