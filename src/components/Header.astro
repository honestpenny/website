---
import Logo from "./Logo.astro";
const topics = [
  // Only topics that have guides. Add a link when its first guide ships.
  { href: "/guides/#bills", label: "Bills" },
  { href: "/guides/#housing", label: "Property tax" },
  { href: "/guides/#tax", label: "Tax" },
  { href: "/guides/tfsa-rrsp-fhsa-compared/", label: "Savings accounts" },
  { href: "/guides/honest-penny-steps/", label: "The Steps" },
  { href: "/guides/", label: "All guides" },
  { href: "/about/", label: "About" },
];
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <p class="promise">Independent money help for Albertans</p>
  </div>
  <nav aria-label="Topics" class="topics">
    <div class="wrap"><ul>{topics.map((t) => <li><a href={t.href}>{t.label}</a></li>)}</ul></div>
  </nav>
</header>
<style>
  .site-header { background: var(--spruce); color: #fff; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 1rem; padding-top: 0.6rem; padding-bottom: 0.6rem; }
  .promise { margin: 0; font-size: 0.95rem; color: #e4ecea; }
  .topics { background: #183d3b; border-top: 1px solid #2e6662; }
  .topics ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  .topics li { margin: 0; }
  .topics a { color: #fff; display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; font-size: 1rem; text-decoration: none; }
  .topics a:hover { text-decoration: underline; }
  .topics a:visited { color: #fff; }
</style>
