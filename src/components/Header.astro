---
import Logo from "./Logo.astro";
const links = [
  { href: "/guides/", label: "Guides" },
  { href: "/guides/honest-penny-steps/", label: "The 8 Steps" },
  { href: "/dates/", label: "Key dates" },
  { href: "/check/", label: "Check what you're owed" },
  { href: "/email/", label: "Weekly email" },
  { href: "/about/", label: "About" },
];
const here = Astro.url.pathname;
const current = (href: string) => (here === href || (href === "/guides/" && here.startsWith("/guides/") && here !== "/guides/honest-penny-steps/") ? "page" : undefined);
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      Menu
    </button>
    <nav id="site-nav" aria-label="Main" class="nav">
      <ul>
        {links.map((t) => <li><a href={t.href} aria-current={current(t.href)}>{t.label}</a></li>)}
        <li class="help"><a href="/get-help/" class="help-link" aria-current={here === "/get-help/" ? "page" : undefined}>Get help</a></li>
      </ul>
    </nav>
  </div>
</header>
<script is:inline>
  // Disclosure menu (button + panel; not an ARIA menu). Without JS the nav is simply shown.
  (() => {
    const btn = document.querySelector(".menu-btn"), nav = document.getElementById("site-nav");
    if (!btn || !nav) return;
    const mq = matchMedia("(max-width: 67.99rem)");
    const set = (open) => { btn.setAttribute("aria-expanded", String(open)); nav.dataset.open = String(open); };
    const apply = () => { btn.hidden = !mq.matches; set(false); };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { set(false); btn.focus(); }
    });
    mq.addEventListener("change", apply); apply();
  })();
</script>
<style>
  .site-header { background: color-mix(in srgb, var(--bg) 92%, transparent); border-bottom: 1px solid var(--line); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; min-height: 4.75rem; padding-block: 0.5rem; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem; }
  .nav li { margin: 0; }
  .nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.85rem; border-radius: 999px; color: var(--ink); font-weight: 700; font-size: 1rem; text-decoration: none; }
  .nav a:visited { color: var(--ink); }
  .nav a:hover { background: var(--soft); }
  .nav a[aria-current="page"] { background: var(--mint); }
  .nav .help-link { margin-left: 0.5rem; background: var(--forest); color: var(--on-forest); padding: 0 1.1rem; }
  .nav .help-link:visited { color: var(--on-forest); }
  .nav .help-link:hover, .nav .help-link[aria-current="page"] { background: var(--forest-2); color: var(--on-forest); }
  @media (prefers-color-scheme: dark) { .nav .help-link, .nav .help-link:visited { background: var(--green); color: #0f1715; } .nav .help-link:hover { background: #a6e4d4; color: #0f1715; } }
  .menu-btn { background: var(--soft); color: var(--ink); border: 0; font-size: 1rem; padding: 0.5rem 1.1rem; min-height: 44px; }
  .menu-btn:hover { background: var(--mint); color: var(--ink); }
  @media (max-width: 67.99rem) {
    .nav { flex-basis: 100%; }
    .nav[data-open="false"] { display: none; }
    .nav ul { flex-direction: column; align-items: stretch; gap: 0.25rem; padding: 0.5rem 0 1rem; }
    .nav a { display: flex; padding: 0 1rem; font-size: 1.1rem; min-height: 52px; border-radius: var(--r-sm); }
    .nav .help-link { margin: 0.5rem 0 0; justify-content: center; }
  }
</style>
