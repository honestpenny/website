---
// Original object-led spot drawings (Ledger & Patina): two inks, square line caps, no people, no coin artwork.
// Decorative only (aria-hidden). Commissioned illustration can replace these later (see docs/DESIGN.md).
interface Props { name: "jar" | "receipt" | "calendar" }
const { name } = Astro.props;
---
<svg class="spot" viewBox="0 0 160 120" aria-hidden="true" focusable="false">
  {name === "jar" && (<g fill="none" stroke-linecap="square" stroke-linejoin="miter">
    <path d="M56 30h48v10c10 6 14 14 14 26v34c0 6-4 10-10 10H52c-6 0-10-4-10-10V66c0-12 4-20 14-26z" stroke="var(--ink)" stroke-width="3" />
    <path d="M54 22h52v8H54z" stroke="var(--ink)" stroke-width="3" />
    <circle cx="70" cy="92" r="9" fill="var(--copper)" stroke="var(--copper-deep, #6b3412)" stroke-width="2" />
    <circle cx="89" cy="96" r="9" fill="var(--copper)" stroke="var(--copper-deep, #6b3412)" stroke-width="2" />
    <circle cx="80" cy="78" r="9" fill="var(--verdigris)" stroke="var(--ink)" stroke-width="2" />
    <path d="M128 18l4 8M138 30l8-2M134 40l7 5" stroke="var(--copper)" stroke-width="3" />
  </g>)}
  {name === "receipt" && (<g fill="none" stroke-linecap="square">
    <path d="M44 10h62v96l-6-5-6 5-6-5-6 5-6-5-6 5-6-5-6 5-6-5-8 5z" stroke="var(--ink)" stroke-width="3" fill="var(--receipt)" />
    <path d="M54 26h30M54 38h42M54 50h36M54 62h42" stroke="var(--border)" stroke-width="3" />
    <path d="M54 80h42" stroke="var(--ink)" stroke-width="3" />
    <circle cx="112" cy="70" r="20" stroke="var(--copper)" stroke-width="4" fill="none" />
    <path d="M126 85l16 16" stroke="var(--copper)" stroke-width="6" />
  </g>)}
  {name === "calendar" && (<g fill="none" stroke-linecap="square">
    <path d="M36 24h88v80H36z" stroke="var(--ink)" stroke-width="3" fill="var(--receipt)" />
    <path d="M36 24h88v18H36z" fill="var(--copper)" stroke="var(--ink)" stroke-width="3" />
    <path d="M58 14v18M102 14v18" stroke="var(--ink)" stroke-width="4" />
    <path d="M50 58h12M74 58h12M98 58h12M50 76h12M74 76h12M50 94h12" stroke="var(--border)" stroke-width="4" />
    <path d="M94 70l8 8 16-18" stroke="var(--verdigris)" stroke-width="5" />
  </g>)}
</svg>
<style>.spot { width: clamp(7rem, 18vw, 10rem); height: auto; display: block; }</style>
