---
// The chinook arch: a band of clear sky under a long cloud edge, the prairie's sign that warm air is coming.
// Used ONLY as the seasonal header of the weekly email (and its preview), never as page decoration.
// Season picks the sky colour; text never sits on it.
interface Props { season?: "winter" | "spring" | "summer" | "fall" }
const month = new Date().getUTCMonth();
const { season = month < 2 || month === 11 ? "winter" : month < 5 ? "spring" : month < 8 ? "summer" : "fall" } = Astro.props;
const sky = { winter: "#dceae6", spring: "#e6efd9", summer: "#f6e0cc", fall: "#eadbb8" }[season];
---
<svg class="chinook" viewBox="0 0 600 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <rect width="600" height="90" fill={sky} />
  <path d="M0 0H600V34C470 18 330 14 210 22C120 28 50 36 0 44Z" fill="#5c554d" opacity="0.85" />
  <path d="M0 78C80 70 150 74 230 70C330 64 420 72 600 66V90H0Z" fill="#8f4a1c" opacity="0.9" />
  <path d="M0 84C120 80 260 83 600 78V90H0Z" fill="#1f4d4a" />
</svg>
<style>.chinook { display: block; width: 100%; height: 72px; }</style>
