---
// Wordmark: an ORIGINAL copper disc with a tick (never Mint coin artwork: no maple twig, no effigy, no
// "CANADA" + date coin layout; see the legal note in docs/DESIGN.md) and the name in the display serif.
---
<a href="/" class="logo" aria-label="Honest Penny home">
  <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="18.5" fill="#b5652b" stroke="#6b3412" stroke-width="2.5" />
    <circle cx="20" cy="20" r="13" fill="none" stroke="#f3c9a5" stroke-width="1.4" stroke-dasharray="2 2.6" />
    <path d="M13.5 20.5l4.2 4.2 8.6-9.4" fill="none" stroke="#fffdf7" stroke-width="3" stroke-linecap="square" />
  </svg>
  <span>Honest Penny</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--ink); text-decoration: none; font: 700 1.6rem/1 var(--serif); letter-spacing: -0.02em; min-height: 44px; }
  .logo:visited { color: var(--ink); }
  .logo:hover span { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
</style>
