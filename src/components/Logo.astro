---
// Logo: original copper coin with a cent sign (source of truth: scripts/make-brand.mjs) + wordmark in the display face.
---
<a href="/" class="logo" aria-label="Honest Penny home">
  <svg width="38" height="38" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <circle cx="32" cy="32" r="31" fill="#FF9A5C" />
    <circle cx="32" cy="32" r="25.5" fill="none" stroke="#12332E" stroke-opacity="0.22" stroke-width="2" />
    <path d="M 41.5 24.2 A 12 12 0 1 0 41.5 39.8" fill="none" stroke="#12332E" stroke-width="6" stroke-linecap="round" />
    <path d="M 33 13.5 V 50.5" stroke="#12332E" stroke-width="4.5" stroke-linecap="round" />
  </svg>
  <span>Honest Penny</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); text-decoration: none; font: 800 1.45rem/1 var(--display); letter-spacing: -0.03em; min-height: 44px; }
  .logo:visited { color: var(--ink); }
  .logo:hover span { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
</style>
