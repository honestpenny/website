// Wordmark: a plain copper penny and the name in the heading serif. No gradient, no glyph tricks.
---
<a href="/" class="logo" aria-label="Honest Penny home">
  <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" focusable="false">
    <circle cx="15" cy="15" r="13.5" fill="#b5652b" stroke="#8c4718" stroke-width="2" />
    <circle cx="15" cy="15" r="9" fill="none" stroke="#f6eadf" stroke-width="1.2" opacity="0.7" />
  </svg>
  <span>Honest Penny</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; color: #fff; text-decoration: none; font: 700 1.35rem/1 var(--serif); min-height: 44px; }
  .logo:visited { color: #fff; }
</style>
