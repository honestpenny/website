---
// One guide in a list: topic, title, summary, reading time, date checked. The whole row is one link target.
import type { CollectionEntry } from "astro:content";
import { topicLabel, readingMinutes } from "../lib/guides";
import { longDate, isoDate } from "../lib/format";
interface Props { g: CollectionEntry<"guides">; headingLevel?: 2 | 3; showTopic?: boolean }
const { g, headingLevel = 3, showTopic = true } = Astro.props;
const H = `h${headingLevel}`;
---
<li class="card">
  {showTopic && <span class="chip">{topicLabel(g.data.topic)}</span>}
  <H class="card-h"><a href={`/guides/${g.id}/`}>{g.data.title}</a></H>
  <p class="card-sum">{g.data.summary}</p>
  <p class="card-meta muted">{readingMinutes(g)} min read · Checked <time datetime={isoDate(g.data.lastChecked)}>{longDate(g.data.lastChecked)}</time></p>
</li>
<style>
  .card { position: relative; list-style: none; margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.35rem 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .card:hover { border-color: var(--border); }
  .card:focus-within { outline: 3px solid var(--copper); outline-offset: 2px; }
  .card .chip { align-self: flex-start; }
  .card-h { font-size: 1.25rem; font-weight: 700; margin: 0.15rem 0 0; line-height: 1.25; }
  .card-h a { color: var(--ink); text-decoration: none; }
  .card-h a:visited { color: var(--ink); }
  /* Stretch the title link over the whole card (one tab stop, big tap target). */
  .card-h a::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .card-h a:focus-visible { outline: none; }
  .card:hover .card-h a { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .card-sum { margin: 0; font-size: 1.02rem; }
  .card-meta { margin: auto 0 0; font-size: 0.9rem; padding-top: 0.35rem; }
</style>
