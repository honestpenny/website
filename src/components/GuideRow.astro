---
// One guide as a ledger entry: topic, title, summary, reading time, date checked. The whole row is one link target.
import type { CollectionEntry } from "astro:content";
import { topicLabel, readingMinutes } from "../lib/guides";
import { longDate, isoDate } from "../lib/format";
interface Props { g: CollectionEntry<"guides">; headingLevel?: 2 | 3 | 4; showTopic?: boolean }
const { g, headingLevel = 3, showTopic = true } = Astro.props;
const H = `h${headingLevel}` as "h2" | "h3" | "h4";
---
<li class="card lift entry">
  {showTopic && <span class="tag">{topicLabel(g.data.topic)}</span>}
  <H class="entry-h"><a class="card-link" href={`/guides/${g.id}/`}>{g.data.title}</a></H>
  <p class="entry-sum muted">{g.data.summary}</p>
  <p class="entry-meta"><span>{readingMinutes(g)} min read</span><span aria-hidden="true">·</span><span>Checked <time datetime={isoDate(g.data.lastChecked)}>{longDate(g.data.lastChecked)}</time></span></p>
</li>
<style>
  .entry { display: flex; flex-direction: column; gap: 0.6rem; }
  .entry .tag { align-self: flex-start; }
  .entry-h { font-size: 1.3rem; margin: 0.1rem 0 0; line-height: 1.2; }
  .entry-sum { margin: 0; font-size: 1rem; }
  .entry-meta { margin: auto 0 0; padding-top: 0.5rem; font-size: 0.9rem; display: flex; flex-wrap: wrap; gap: 0.4rem; color: var(--muted); }
</style>
