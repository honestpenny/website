---
import { site } from "../lib/site";
---
<footer class="site-footer">
  <div class="wrap">
    <p class="how"><strong>How this site works:</strong> Honest Penny is free and independent. No company can pay to be listed or ranked. General information only, not personal financial advice. If something here is wrong, <a href="/corrections/">tell us and we'll fix it</a>.</p>
    <ul class="links">
      <li><a href="/about/">Who we are</a></li>
      <li><a href="/editorial-code/">Editorial code</a></li>
      <li><a href="/how-we-make-money/">How we make money</a></li>
      <li><a href="/how-we-check-facts/">How we check facts and use AI</a></li>
      <li><a href="/corrections/">Corrections</a></li>
      <li><a href="/privacy/">Privacy</a></li>
    </ul>
    <p class="muted small">© {new Date().getFullYear()} {site.name}. Made in {site.region}.</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 3px solid var(--copper); margin-top: 4rem; padding: 2rem 0 3rem; font-size: 1rem; }
  .how { max-width: var(--measure); }
  .links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; }
  .small { font-size: 0.9rem; }
</style>
