---
import Logo from "./Logo.astro";
import { site } from "../lib/site";
const cols = [
  { h: "Guides", links: [
    ["/guides/#bills", "Bills"], ["/guides/#housing", "Property tax"], ["/guides/#tax", "Tax"],
    ["/guides/tfsa-rrsp-fhsa-compared/", "Savings accounts"], ["/guides/", "All guides"] ] },
  { h: "Tools", links: [
    ["/check/", "Check what you're owed"], ["/guides/honest-penny-steps/", "The 8 Steps"], ["/dates/", "Key dates"], ["/email/", "Weekly email"], ["/get-help/", "Get help"] ] },
  { h: "Trust", links: [
    ["/about/", "Who we are"], ["/editorial-code/", "Editorial code"], ["/how-we-make-money/", "How we make money"],
    ["/how-we-check-facts/", "How we check facts and use AI"], ["/corrections/", "Corrections"], ["/privacy/", "Privacy"], ["/terms/", "Terms and disclaimer"] ] },
  
];
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <Logo />
      <p class="how"><strong>How this site works:</strong> Honest Penny is free and independent. No company can pay to be listed or ranked. General information only, not personal financial advice. <a href="/terms/">Read our terms</a>. If something here is wrong, <a href="/corrections/">tell us and we'll fix it</a>.</p>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.h} class="col">
        <h2 class="col-h">{c.h}</h2>
        <ul class="links">{c.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="wrap base"><p class="muted small">© {new Date().getFullYear()} {site.name}. Made in {site.region}. Contact: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p></div>
</footer>
<style>
  .site-footer { background: var(--kraft); border-top: 2px solid var(--ink); margin-top: 5rem; padding: 3rem 0 1.5rem; font-size: 1rem; }
  .grid { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .grid { grid-template-columns: 1.5fr 1fr 1fr 1.1fr; } }
  .how { max-width: 30rem; margin-top: 1rem; }
  .col-h { font: 650 1.15rem/1.3 var(--serif); margin: 0 0 0.5rem; }
  .links { list-style: none; padding: 0; margin: 0; }
  .links li { margin: 0; }
  .links a { display: inline-flex; align-items: center; min-height: 40px; min-width: 24px; }
  .base { border-top: 1px solid var(--border); margin-top: 2rem; padding-top: 1rem; }
  .base p { margin: 0; }
</style>
