---
import Logo from "./Logo.astro";
import { site } from "../lib/site";
const cols = [
  { h: "Guides", links: [
    ["/guides/#bills", "Bills"], ["/guides/#housing", "Property tax"], ["/guides/#tax", "Tax"],
    ["/guides/tfsa-rrsp-fhsa-compared/", "Savings accounts"], ["/guides/", "All guides"] ] },
  { h: "Tools", links: [
    ["/check/", "Check what you're owed"], ["/steps/", "The 8 Steps"], ["/dates/", "Key dates"], ["/email/", "Weekly email"], ["/get-help/", "Get help"] ] },
  { h: "Trust", links: [
    ["/about/", "Who we are"], ["/editorial-code/", "Editorial code"], ["/how-we-make-money/", "How we make money"],
    ["/how-we-check-facts/", "How we check facts and use AI"], ["/corrections/", "Corrections"], ["/privacy/", "Privacy"], ["/terms/", "Terms and disclaimer"] ] },
  
];
---
<footer class="site-footer">
  <div class="wrap fgrid">
    <div class="about">
      <Logo />
      <p class="how"><strong>How this site works:</strong> Honest Penny is free and independent. No company can pay to be listed or ranked. General information only, not personal financial advice. <a href="/terms/">Read our terms</a>. If something here is wrong, <a href="/corrections/">tell us and we'll fix it</a>.</p>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.h} class="col">
        <h2 class="col-h">{c.h}</h2>
        <ul class="links">{c.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="wrap base"><p class="small">© {new Date().getFullYear()} {site.name}. Made in {site.region}. Contact: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> · Website by <a href="https://altasmith.ca/" rel="noopener">Altasmith</a></p></div>
</footer>
<style>
  .site-footer { background: var(--forest); color: var(--on-forest); margin-top: 6rem; padding: 4rem 0 2rem; font-size: 1rem; }
  .site-footer :global(.logo), .site-footer :global(.logo:visited) { color: var(--on-forest); }
  .site-footer p { color: var(--on-forest-muted); }
  .site-footer a, .site-footer a:visited { color: var(--on-forest); }
  .fgrid { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .fgrid { grid-template-columns: 1.5fr 1fr 1fr 1.1fr; } }
  .how { max-width: 30rem; margin-top: 1rem; }
  .col-h { font: 700 1.1rem/1.3 var(--display); margin: 0 0 0.6rem; color: var(--on-forest); }
  .links { list-style: none; padding: 0; margin: 0; }
  .links li { margin: 0; }
  .links a { display: inline-flex; align-items: center; min-height: 40px; min-width: 24px; text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .base { border-top: 1px solid rgb(255 255 255 / 0.2); margin-top: 2.5rem; padding-top: 1.25rem; }
  .base p { margin: 0; }
  .site-footer strong { color: var(--on-forest); }
</style>
