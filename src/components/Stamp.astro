---
// "Fact-checked" badge: who checked, when, and when it's next checked. Real text, links to who we are.
import { longDate, isoDate } from "../lib/format";
interface Props { checked: Date; next?: Date; by: string; byHref?: string; size?: "large" | "small" }
const { checked, next, by, byHref = "/about/" } = Astro.props;
---
<div class="stamp" data-testid="stamp">
  <span class="seal" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17.5 19.5 7" /></svg></span>
  <p class="stamp-text">
    <span class="stamp-h">Fact-checked <time data-testid="last-checked" datetime={isoDate(checked)}>{longDate(checked)}</time></span>
    <span class="stamp-by">by <a href={byHref}>{by}</a>{next && <> · next check {longDate(next)}</>}</span>
  </p>
</div>
<style>
  .stamp { display: inline-flex; align-items: center; gap: 0.75rem; background: var(--mint); border-radius: 999px; padding: 0.5rem 1.25rem 0.5rem 0.5rem; }
  .seal { width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--forest); color: #fff; display: grid; place-items: center; flex: none; }
  @media (prefers-color-scheme: dark) { .seal { background: var(--green); color: #0f1715; } }
  .stamp-text { margin: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .stamp-h { font-weight: 700; font-size: 1rem; }
  .stamp-by { font-size: 0.9rem; color: var(--muted); }
</style>
