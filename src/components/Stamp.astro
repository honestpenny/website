---
// The "Checked" stamp: the brand's signature trust device. Real, horizontal HTML text (>= 16px); only the
// frame has an inked edge (decorative SVG, aria-hidden). Says who checked, when, and when it's next checked.
import { longDate, isoDate } from "../lib/format";
interface Props { checked: Date; next?: Date; by: string; byHref?: string; size?: "large" | "small" }
const { checked, next, by, byHref = "/about/", size = "large" } = Astro.props;
---
<div class={`stamp ${size}`} data-testid="stamp">
  <svg class="seal" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
    <circle cx="28" cy="28" r="25" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="40 3 22 2 60 4" />
    <circle cx="28" cy="28" r="19" fill="none" stroke="currentColor" stroke-width="1.2" />
    <path d="M19 28.5l6 6 12-13" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="square" />
  </svg>
  <p class="stamp-text">
    <span class="stamp-h">Checked <time data-testid="last-checked" datetime={isoDate(checked)}>{longDate(checked)}</time></span>
    <span class="stamp-by">by <a href={byHref}>{by}</a>{next && <> · next check {longDate(next)}</>}</span>
  </p>
</div>
<style>
  .stamp { display: inline-flex; align-items: center; gap: 0.85rem; color: var(--copper-text); border: 2px solid currentColor; border-radius: var(--radius);
    padding: 0.6rem 1rem 0.6rem 0.7rem; background: var(--receipt); position: relative; }
  .stamp::after { content: ""; position: absolute; inset: 3px; border: 1px solid currentColor; border-radius: 2px; pointer-events: none; opacity: 0.55; }
  .seal { width: 3rem; height: 3rem; flex: none; }
  .stamp.small .seal { width: 2.25rem; height: 2.25rem; }
  .stamp-text { margin: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .stamp-h { font: 700 1.1rem/1.25 var(--serif); color: var(--copper-text); }
  .stamp.small .stamp-h { font-size: 1rem; }
  .stamp-by { font-size: 0.95rem; color: var(--ink); }
  .stamp a { color: var(--link); }
</style>
