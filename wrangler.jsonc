// Assets-only Worker: no Worker script, so every request is a free static-asset request.
// Deployed by Cloudflare Workers Builds from the GitHub repo (NOT by GitHub Actions; see CLAUDE.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website", // must match the Worker name in the Cloudflare dashboard
  "workers_dev": true, // preview host; _headers sends noindex there
  "preview_urls": true, // per-branch previews for PRs (also noindex)
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist/",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
