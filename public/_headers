# Security headers for every response. Cloudflare applies this file to static assets.
# Local `astro preview` does NOT apply it: test headers with `curl -sI` against a real
# Cloudflare preview or production (Code To Cloud LESSONS_LEARNED §13/§26).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  # Do NOT tighten to same-origin/no-referrer: form providers that check the referrer
  # (Kit, Formspree) then silently reject or spam-file real signups (C2C LESSONS §37).
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  # Astro inlines small scripts/styles; 'unsafe-inline' is deliberate (C2C LESSONS §14:
  # a strict script-src blanked the live site). Add a host here only when a page uses it.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://app.kit.com; form-action 'self' https://app.kit.com; frame-ancestors 'none'; base-uri 'self'

# Keep workers.dev and preview hostnames out of search results.
https://:project.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/build.txt
  Cache-Control: no-store
